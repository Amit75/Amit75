NODE_ENV=production
HOST=127.0.0.1
PORT=8080
AARULYA_PUBLIC_ORIGIN=https://api.store.aarulya.com
AARULYA_ALLOWED_ORIGINS=https://store.aarulya.com
AARULYA_STOREFRONT_ORIGIN=https://store.aarulya.com
AARULYA_DOWNLOAD_ORIGIN=https://downloads.store.aarulya.com
AARULYA_EVIDENCE_ORIGIN=https://evidence.store.aarulya.com
AARULYA_DATABASE_SSL_MODE=verify-full
AARULYA_DATABASE_APP_NAME=aarulya-store-api
AARULYA_DATABASE_POOL_MAX=10
AARULYA_DATABASE_URL_FILE=/run/secrets/api_database_url
AARULYA_PUBLISHER_DATABASE_URL_FILE=/run/secrets/publisher_database_url
AARULYA_DOWNLOAD_TOKEN_HMAC_KEY_FILE=/run/secrets/download_token_hmac_key
AARULYA_OIDC_ISSUER=https://identity.aarulya.com
AARULYA_OIDC_AUDIENCE=aarulya-store-api
AARULYA_OIDC_JWKS_URI=https://identity.aarulya.com/.well-known/jwks.json
AARULYA_OIDC_ALGORITHMS=EdDSA,ES256,PS256,RS256
AARULYA_OIDC_CLOCK_TOLERANCE_SECONDS=60

# Every service must receive a distinct database login through a root-owned secret file:
# migrator_database_url, api_database_url, publisher_database_url,
# downloads_database_url and worker_database_url.
# The HMAC key must be an independent random secret of at least 32 bytes.
# Direct inline production secrets are rejected by the runtime.

# Separate artifact services use their own process/service identities:
# Downloads: AARULYA_ARTIFACT_MODE=downloads, PORT=8081,
#            AARULYA_PUBLIC_ORIGIN=https://downloads.store.aarulya.com
# Evidence:  AARULYA_ARTIFACT_MODE=evidence, PORT=8082,
#            AARULYA_PUBLIC_ORIGIN=https://evidence.store.aarulya.com
# AARULYA_ARTIFACT_ROOT must be a private mounted directory, never a public web root.

# Never commit credentials, signing material, OIDC client secrets, access tokens,
# HMAC keys, private keys, recovery codes or private artifact-storage credentials.
