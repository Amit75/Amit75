NODE_ENV=production
HOST=127.0.0.1
PORT=8080
AARULYA_PUBLIC_ORIGIN=https://store.aarulya.com
AARULYA_ALLOWED_ORIGINS=https://store.aarulya.com
AARULYA_DATABASE_SSL_MODE=verify-full
AARULYA_DATABASE_APP_NAME=aarulya-store-api
# AARULYA_DATABASE_URL must be injected by the deployment secret manager.
# Never commit credentials, signing material, access tokens or private keys.
